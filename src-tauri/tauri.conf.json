{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mintu Studio",
  "version": "0.1.0",
  "identifier": "com.mintu.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mintu Studio",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Standalone AI Code Workspace with Local and Cloud Models",
    "longDescription": "Mintu Studio is a standalone desktop AI code workspace supporting local models and cloud providers with strict workspace security.",
    "copyright": "Copyright 2026 Mintu Studio Contributors (GPL-3.0-only; marketplace/ under MIT)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ts", "tsx", "js", "jsx", "mjs", "cjs",
          "py", "rs", "go", "c", "cpp", "h", "hpp",
          "java", "cs", "php", "rb", "lua",
          "json", "yaml", "yml", "toml", "xml", "csv",
          "html", "htm", "css", "scss", "vue", "svelte",
          "md", "txt", "sql", "sh", "ps1", "bat"
        ],
        "name": "Mintu Studio Source File",
        "description": "Open with Mintu Studio",
        "role": "Editor"
      }
    ]
  }
}
